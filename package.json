{
  "name": "meshrouter",
  "version": "1.0.0",
  "description": "MeshRouter — lokalna sieć Android i test przekazania danych przez telefony; oddzielne demo web.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "test": "node --test tests/*.test.js",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "cap:sync": "npm run build && cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/clipboard": "^6.0.3",
    "@capacitor/core": "^6.1.2",
    "@capacitor/share": "^6.0.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.2",
    "vite": "^5.4.8"
  }
}
